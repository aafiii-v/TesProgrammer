<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TesProgrammer</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TesProgrammer.styles.css" asp-append-version="true" />

    <style>
        body {
            background-color: #f5f6fa;
            font-family: Arial, sans-serif;
        }

        header {
            background-color: #1e293b;
        }

        .navbar-brand, .nav-link {
            color: white !important;
            font-weight: 500;
        }

            .navbar-brand:hover, .nav-link:hover {
                color: #38bdf8 !important;
            }

            .nav-link.active {
                color: #38bdf8 !important;
                font-weight: 700;
            }

        h4 {
            background: yellow;
            padding: 5px;
            width: fit-content;
        }

        form, .table {
            font-size: 14px;
        }

        .btn-primary {
            background-color: #3b82f6;
            border: none;
        }

        .btn-secondary {
            background-color: #9ca3af;
            border: none;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()?.Equals("MataKuliah", StringComparison.OrdinalIgnoreCase) == true ? "active" : "")"
                               asp-area="" asp-controller="MataKuliah" asp-action="Index">
                                Mata Kuliah
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()?.Equals("Dosen", StringComparison.OrdinalIgnoreCase) == true ? "active" : "")"
                               asp-area="" asp-controller="Dosen" asp-action="Index">
                                Dosen & Mata Kuliah
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container bg-white p-4 shadow-sm rounded">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
